# Supabase (obrigatório para integração com banco)
# Obtenha em: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=seu-chave-de-servico-do-supabase

# Servidor
PORT=3000
HOST=0.0.0.0

# Senha admin (só no primeiro boot; depois vive no Supabase)
ADMIN_PASSWORD=sua-senha-forte-aqui

# Apenas se estiver atrás de proxy (Nginx/Cloudflare/Render)
TRUST_PROXY=0
